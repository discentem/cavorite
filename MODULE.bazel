###############################################################################
# Bazel now uses Bzlmod by default to manage external dependencies.
# Please consider migrating your external dependencies from WORKSPACE to MODULE.bazel.
#
# For more details, please check https://github.com/bazelbuild/bazel/issues/18958
###############################################################################

module(
    name = "cavorite",
    version = "1.0.0",
)

# Core Bzlmod-compatible dependencies
bazel_dep(name = "rules_go", version = "0.51.0")
bazel_dep(name = "gazelle", version = "0.40.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_platform", version = "0.1.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4")

# Load the go dependencies using Gazelle
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_aws_aws_sdk_go_v2",
    "com_github_aws_aws_sdk_go_v2_config",
    "com_github_aws_aws_sdk_go_v2_feature_s3_manager",
    "com_github_aws_aws_sdk_go_v2_service_s3",
    "com_github_azure_azure_sdk_for_go_sdk_azidentity",
    "com_github_azure_azure_sdk_for_go_sdk_storage_azblob",
    "com_github_carolynvs_aferox",
    "com_github_fsouza_fake_gcs_server",
    "com_github_gonuts_go_shellquote",
    "com_github_google_logger",
    "com_github_hashicorp_go_hclog",
    "com_github_hashicorp_go_multierror",
    "com_github_hashicorp_go_plugin",
    "com_github_mitchellh_go_homedir",
    "com_github_spf13_afero",
    "com_github_spf13_cobra",
    "com_github_spf13_viper",
    "com_github_stretchr_testify",
    "com_google_cloud_go_storage",
    "org_golang_google_api",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)
